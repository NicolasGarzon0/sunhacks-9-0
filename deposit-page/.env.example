# Public configuration only. Nothing secret ever goes in the frontend.
VITE_API_BASE_URL=http://127.0.0.1:8788/markets
VITE_WALLET_MODE=local
VITE_EXPLORER_CLUSTER=devnet

# Wallet mode: "local" (throwaway test wallet) or "privy" (email login, embedded Solana wallet).
# For privy mode, set VITE_WALLET_MODE=privy in .env.local and fill in the ids below. These are public ids, never secrets.
# There is no Privy app secret and this page never uses one.
VITE_PRIVY_APP_ID=
# Optional: only set it if your Privy app has a client id.
VITE_PRIVY_CLIENT_ID=
