# Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Gateway
# Base URL of the backend that receives POST /inbound (no trailing path).
BACKEND_URL=
# Shared secret sent/expected in the X-Gateway-Secret header (both directions).
GATEWAY_SHARED_SECRET=
# Port the gateway's HTTP server listens on (default 8787).
PORT=8787
# Optional: debug | info | warn | error (default info). debug also logs message text.
LOG_LEVEL=info

# Optional, for scripts only
# GATEWAY_URL=http://localhost:8787   (also used by the backend; default http://localhost:8787)
# MOCK_BACKEND_PORT=8788

# Python backend (backend/) reads this same file. It ignores PORT (the gateway's) and listens on
# BACKEND_PORT, else the port in BACKEND_URL, else 8788.
SUPABASE_URL=
# Never logged, never sent to clients. Unused in chunk 1.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase dashboard > Connect > Session pooler). Required by the backend.
DATABASE_URL=
# Secret for X-Admin-Secret on the backend's /admin/* endpoints. Required by the backend.
ADMIN_SECRET=
# Optional override for the backend port.
# BACKEND_PORT=8788

# Bet extraction (backend chunk 2)
# Anthropic API key for the Haiku extraction call. Required by the backend. Never logged.
ANTHROPIC_API_KEY=
# Optional (defaults shown). claude-haiku-5-5 is the current Haiku model ID.
# HAIKU_MODEL=claude-haiku-5-5
# LOCAL_TIMEZONE=America/Phoenix

# Game lookup (backend chunk 3)
# simulated (default; fixed schedule in backend/games/data/schedule.json) or realtime (NFL via realtimesportsapi.com)
# GAME_PROVIDER=simulated
# API key for realtimesportsapi.com. Required only when GAME_PROVIDER=realtime. Never logged.
SPORTS_API_KEY=

# Pool markets (backend chunk 4). Placeholders only; money is in dollars here and converted to USDC base units.
# At least 32 random characters. Signs the bet links. Required by the backend. Never logged.
LINK_SIGNING_SECRET=
# Where the deposit page lives. The bet link is DEPOSIT_PAGE_URL/b/<token>. Required by the backend.
DEPOSIT_PAGE_URL=http://localhost:5173
# Optional: allowed CORS origin for the market API (default: the origin of DEPOSIT_PAGE_URL).
# DEPOSIT_PAGE_ORIGIN=http://localhost:5173
# Optional (defaults shown).
# MIN_STAKE_USD=1
# MAX_STAKE_USD=20
# MAX_PARTICIPANTS=20
# FEE_BPS=500   (5% of the losing side; hard cap 1000)
# TREASURY_PUBKEY=   (mock mode falls back to a clearly fake constant; real mode requires it)
# LINK_GRACE_HOURS=2
# FUNDING_MINUTES_BEFORE_KICKOFF=60
# SETTLE_HOURS_AFTER_KICKOFF=6
# CHAIN_MODE=mock   (real is not implemented yet)

# Worker (backend chunk 5). Optional, defaults shown in backend/README.md.
# WORKER_ENABLED=
# WORKER_TICK_SECONDS=
# RESULT_POLL_START_HOURS_AFTER_KICKOFF=
# RESULT_POLL_INTERVAL_MINUTES=
# SETTLE_CONFIRM_WAIT_MINUTES=
# SPORTS_CALL_BUDGET_MONTHLY=
# CLAIM_MAX_ATTEMPTS=
# CLAIM_BACKOFF_SECONDS=
# NOTICE_MAX_ATTEMPTS=
# LINK_GRACE_MINUTES=

# Solana devnet (contracts chunk 2). Values come from contracts/.keys/env.generated (gitignored, never commit it).
# Secrets are base64 of the 64 byte secret key, set as env values on the host, never as files.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# PROGRAM_ID=
# TEST_USDC_MINT=
# PAYER_SECRET_KEY=
# ORACLE_SECRET_KEY=
# TREASURY_PUBKEY=   (same variable as in the pool markets block above)
# MINT_AUTHORITY_SECRET_KEY=
