# Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Gateway
# Base URL of the backend that receives POST /inbound (no trailing path).
BACKEND_URL=
# Shared secret sent/expected in the X-Gateway-Secret header (both directions).
GATEWAY_SHARED_SECRET=
# Port the gateway's HTTP server listens on (default 8787).
PORT=8787
# Optional: debug | info | warn | error (default info). debug also logs message text.
LOG_LEVEL=info

# Optional, for scripts only
# GATEWAY_URL=http://localhost:8787
# MOCK_BACKEND_PORT=8788
