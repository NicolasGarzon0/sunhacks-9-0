{
  "name": "handshake-pool-contracts",
  "private": true,
  "license": "ISC",
  "scripts": {
    "build": "anchor build --arch v0",
    "test:litesvm": "anchor build --arch v0 && ts-mocha -p ./tsconfig.json -t 1000000 \"tests/**/*.test.ts\"",
    "test:validator": "anchor build --arch v0 && anchor test --validator legacy --skip-build",
    "test:rust": "cargo test -p handshake_pool",
    "test": "npm run test:rust && npm run test:litesvm && npm run test:validator",
    "keys": "ts-node -P tsconfig.json scripts/keys.ts",
    "fund": "ts-node -P tsconfig.json scripts/fund.ts",
    "deploy": "ts-node -P tsconfig.json scripts/deploy.ts",
    "mint:create": "ts-node -P tsconfig.json scripts/create_mint.ts",
    "airdrop": "ts-node -P tsconfig.json scripts/airdrop_usdc.ts",
    "smoke": "ts-node -P tsconfig.json scripts/smoke.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.2"
  },
  "devDependencies": {
    "@solana/kit": "^8.6.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^26.6.6",
    "chai": "^4.3.4",
    "litesvm": "^1.6.2",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
