{
  "name": "handshake-chain-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:devnet": "RUN_DEVNET_TESTS=1 tsx --test test/devnet.test.ts",
    "sync-idl": "cp ../contracts/target/idl/handshake_pool.json idl/handshake_pool.json",
    "dev-deposit": "tsx scripts/dev_deposit.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
